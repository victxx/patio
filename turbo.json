{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "PATIO_HOODI_EXTERNAL_PROVIDERS_ENABLED",
        "PATIO_HOODI_BETA_ENABLED",
        "PATIO_STATION_FREQUENCY"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": []
    }
  }
}
